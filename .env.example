# ==============================================================================
# The Velaris Residences — Production & Local Environment Variables
# ==============================================================================

# Database — Supabase Postgres (ap-southeast-1 Singapore, co-located with Vercel sin1)
# Runtime pooled URL (Transaction Pooler port 6543 with Supavisor):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct unpooled URL for migrations (port 5432 direct host):
DATABASE_URL_UNPOOLED="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Payload CMS
PAYLOAD_SECRET="replace-with-a-secure-random-32-byte-hex-string"
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# Storage — Vercel Blob
# Public marketing media storage adapter:
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_here"
# Private storage token (authenticated KYC and reservation documents):
VERCEL_BLOB_PRIVATE_TOKEN="vercel_blob_rw_private_token_here"

# Email — Resend
RESEND_API_KEY="re_123456789"
RESEND_FROM_ADDRESS="The Velaris Residences <noreply@thevelarisresidences.com>"

# Cron Authentication
# Vercel Cron sends this in Authorization: Bearer <CRON_SECRET> header:
CRON_SECRET="replace-with-secure-cron-secret-token"

# Deployment
NODE_ENV="development"
